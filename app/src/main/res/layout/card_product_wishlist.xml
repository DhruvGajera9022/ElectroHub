<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_bg"
    android:layout_margin="5dp"
    android:elevation="5dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_margin="5dp"
        android:layout_height="147dp">

        <!-- Product Image -->
        <ImageView
            android:id="@+id/cardWishlistProductImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/boatearbuds" />
    </FrameLayout>

    <!-- FrameLayout for Product Info -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/card_background">

        <!-- Main LinearLayout -->
        <LinearLayout
            android:id="@+id/cardWishlistProductLinearLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Product Name -->
            <TextView
                android:id="@+id/cardWishlistProductName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/boat"
                android:layout_marginHorizontal="10dp"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:fontFamily="@font/poppinssemibold" />

            <!-- Product Description -->
            <TextView
                android:id="@+id/cardWishlistProductDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:textSize="12sp"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/poppinsregular" />

            <!-- Price Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹"
                    android:textColor="#6055D8"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppinssemibold" />

                <TextView
                    android:id="@+id/cardWishlistProductPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#6055D8"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppinssemibold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
