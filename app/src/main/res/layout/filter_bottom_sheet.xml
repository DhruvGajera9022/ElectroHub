<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/sheet_background">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/filter_products"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="@font/poppinssemibold"
        android:textColor="@android:color/black"
        android:layout_marginBottom="16dp"/>

    <!-- Sort By Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sort_by"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/poppinssemibold"
        android:layout_marginBottom="8dp"/>

    <RadioGroup
        android:id="@+id/sortByRadioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/sortByName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/name"
            android:fontFamily="@font/poppinsregular"
            android:checked="true"/>

        <RadioButton
            android:id="@+id/sortByPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/price"
            android:fontFamily="@font/poppinsregular"
            android:layout_marginStart="16dp"/>

        <RadioButton
            android:id="@+id/sortByCompany"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/company"
            android:fontFamily="@font/poppinsregular"
            android:layout_marginStart="16dp"/>
    </RadioGroup>

    <!-- Order Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Order"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/poppinssemibold"
        android:layout_marginBottom="8dp"/>

    <RadioGroup
        android:id="@+id/orderRadioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/orderAscending"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ascending"
            android:fontFamily="@font/poppinsregular"
            android:checked="true"/>

        <RadioButton
            android:id="@+id/orderDescending"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/descending"
            android:fontFamily="@font/poppinsregular"
            android:layout_marginStart="16dp"/>
    </RadioGroup>

    <!-- Price Range Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/price_range"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/poppinssemibold"
        android:layout_marginBottom="8dp"/>

    <com.google.android.material.slider.RangeSlider
        android:id="@+id/priceRangeSlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="250000"
        android:fontFamily="@font/poppinsregular"
        app:values="@array/price_range_default"
        app:labelBehavior="visible"/>

    <!-- Category Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/category"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/poppinssemibold"
        android:layout_marginBottom="8dp"/>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/categoryChipGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            android:fontFamily="@font/poppinsregular">
            <!-- Chips will be added dynamically -->
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Company Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/company"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/poppinssemibold"
        android:layout_marginBottom="8dp"/>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/companyChipGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            android:fontFamily="@font/poppinsregular">
            <!-- Chips will be added dynamically -->
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp">

        <Button
            android:id="@+id/resetFilterBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/reset"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/poppinsregular"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

        <Button
            android:id="@+id/applyFilterBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/apply"
            android:fontFamily="@font/poppinsregular"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</LinearLayout>