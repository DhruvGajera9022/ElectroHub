<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".CategoryScreen.MobilesActivity">

    <include layout="@layout/tool_bar"/>

   <androidx.core.widget.NestedScrollView
       android:id="@+id/mobileScrollView"
       android:layout_width="match_parent"
       android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <HorizontalScrollView
            android:id="@+id/mobileHorizontalScrollView"
            android:layout_width="match_parent"
            android:layout_marginStart="8sp"
            android:layout_marginTop="10sp"
            android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

<!--            iPhone-->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/iphone"
                android:layout_weight="1"
                android:orientation="vertical">
            <de.hdodenhof.circleimageview.CircleImageView
                android:layout_width="60dp"
                android:src="@drawable/logo_apple"
                android:layout_marginHorizontal="10sp"
                android:layout_gravity="center"
                android:layout_height="60dp"/>
            </LinearLayout>

<!--            Samsung-->
            <LinearLayout
                android:id="@+id/samsung"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10sp"
                android:layout_weight="1"
                android:orientation="vertical">
                <de.hdodenhof.circleimageview.CircleImageView
                    android:layout_width="60dp"
                    android:src="@drawable/logo_samsung"
                    android:layout_gravity="center"
                    android:layout_height="60dp"/>

            </LinearLayout>

<!--            Vivo-->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="10sp"
                android:id="@+id/vivo"
                android:orientation="vertical">
                <de.hdodenhof.circleimageview.CircleImageView
                    android:layout_width="60dp"
                    android:layout_gravity="center"
                    android:src="@drawable/logo_vivo"
                    android:layout_height="60dp"/>


            </LinearLayout>

<!--            Oppo-->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/oppo"
                android:layout_marginHorizontal="10sp"
                android:layout_weight="1"
                android:orientation="vertical">
                <de.hdodenhof.circleimageview.CircleImageView
                    android:layout_width="60dp"
                    android:layout_gravity="center"
                    android:src="@drawable/logo_oppo"
                    android:layout_height="60dp"/>

            </LinearLayout>

<!--            MI-->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:id="@+id/mi"
                android:layout_marginHorizontal="10sp"
                android:orientation="vertical">
                <de.hdodenhof.circleimageview.CircleImageView
                    android:layout_width="60dp"
                    android:layout_gravity="center"
                    android:src="@drawable/logo_redmi"
                    android:layout_height="60dp"/>

            </LinearLayout>

<!--            Realme-->
            <LinearLayout
                android:layout_width="wrap_content"
                android:id="@+id/realme"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="10sp"
                android:orientation="vertical">
                <de.hdodenhof.circleimageview.CircleImageView
                    android:layout_width="60dp"
                    android:src="@drawable/logo_realme"
                    android:layout_gravity="center"
                    android:layout_height="60dp"/>

            </LinearLayout>

<!--            Motorola-->
            <LinearLayout
                android:layout_width="wrap_content"
                android:id="@+id/motorola"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="10sp"
                android:orientation="vertical">
                <de.hdodenhof.circleimageview.CircleImageView
                    android:layout_width="60dp"
                    android:src="@drawable/logo_motorola"
                    android:layout_gravity="center"
                    android:layout_height="60dp"/>


            </LinearLayout>

<!--            Poco-->
            <LinearLayout
                android:layout_width="wrap_content"
                android:id="@+id/poco"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="10sp"
                android:orientation="vertical">
                <de.hdodenhof.circleimageview.CircleImageView
                    android:layout_width="60dp"
                    android:src="@drawable/logo_poco"
                    android:layout_gravity="center"
                    android:layout_height="60dp"/>


            </LinearLayout>

<!--            Google-->
            <LinearLayout
                android:id="@+id/goggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="10sp"
                android:orientation="vertical">
                <de.hdodenhof.circleimageview.CircleImageView
                    android:layout_width="60dp"
                    android:src="@drawable/logo_goggle"
                    android:layout_gravity="center"
                    android:layout_height="60dp"/>


            </LinearLayout>

<!--            OnePlus-->
            <LinearLayout
                android:id="@+id/oneplues"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="10sp"
                android:orientation="vertical">
                <de.hdodenhof.circleimageview.CircleImageView
                    android:layout_width="60dp"
                    android:src="@drawable/logo_oneplus"
                    android:layout_gravity="center"
                    android:layout_height="60dp"/>


            </LinearLayout>

<!--            IQOO-->
            <LinearLayout
                android:id="@+id/iqoo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="10sp"
                android:orientation="vertical">
                <de.hdodenhof.circleimageview.CircleImageView
                    android:layout_width="60dp"
                    android:src="@drawable/logo_iqoo"
                    android:layout_gravity="center"
                    android:layout_height="60dp"/>

            </LinearLayout>

<!--            Nothing-->
            <LinearLayout
                android:id="@+id/nothing"
                android:layout_width="wrap_content"
                android:layout_marginHorizontal="10sp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <de.hdodenhof.circleimageview.CircleImageView
                    android:layout_width="60dp"
                    android:src="@drawable/logo_nothing"
                    android:layout_gravity="center"
                    android:layout_height="60dp"/>

            </LinearLayout>



        </LinearLayout>

        </HorizontalScrollView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_margin="7dp"
            card_view:cardElevation="5dp"
            card_view:cardCornerRadius="10dp">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/mobileViewPager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.cardview.widget.CardView>

        <ProgressBar
            android:id="@+id/mobileActivityProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mobileRecyclerView"
            android:layout_width="match_parent"
            android:layout_marginTop="20dp"
            android:layout_height="wrap_content"/>


    </LinearLayout>
</androidx.core.widget.NestedScrollView>
</LinearLayout>